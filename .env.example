# Example Environment Variables for Airlock
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ═══════════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════════

# Node environment (development | production | test)
NODE_ENV=development

# Logging level (debug | info | warn | error)
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# Dev Server Guard Configuration
# ═══════════════════════════════════════════════════════════════

# Public-facing port for Airlock Guard proxy
# This is the port you'll access in your browser
GUARD_PUBLIC_PORT=3000

# Internal target port for your dev server (optional, auto-assigned if not set)
# GUARD_TARGET_PORT=3001

# Allowed Host headers (comma-separated)
# Default: localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1

# ═══════════════════════════════════════════════════════════════
# API Keys and Secrets (Example - Replace with Real Values)
# ═══════════════════════════════════════════════════════════════
# These are examples for the test server demonstration.
# In production, use Secret Gate to keep these out of plaintext files.

# OpenAI API Key
OPENAI_API_KEY=sk-proj-your_actual_openai_key_here

# Stripe API Key
STRIPE_SECRET_KEY=sk_test_your_actual_stripe_key_here

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this

# Session Secret
SESSION_SECRET=your-session-secret-change-this

# ═══════════════════════════════════════════════════════════════
# Secret Gate Configuration
# ═══════════════════════════════════════════════════════════════

# Socket path for Secret Gate (Unix systems)
# Default: /tmp/airlock-secrets.sock
# SECRETGATE_SOCKET_PATH=/tmp/airlock-secrets.sock

# ═══════════════════════════════════════════════════════════════
# MCP Watch Configuration
# ═══════════════════════════════════════════════════════════════

# Project root directory for MCP Watch path validation
# Default: current working directory
# MCP_PROJECT_ROOT=/path/to/your/project

# Enable path traversal detection (true | false)
# Default: true
MCP_DETECTION_ENABLED=true

# Denied path patterns (comma-separated)
# These paths trigger security warnings if accessed
MCP_DENIED_PATHS=.ssh,.aws,.env,id_rsa,credentials

# ═══════════════════════════════════════════════════════════════
# Attack Demo Configuration (For Testing Only)
# ═══════════════════════════════════════════════════════════════

# Attacker server port
ATTACKER_PORT=8888

# Target localhost port to attack
VICTIM_PORT=3000

# ═══════════════════════════════════════════════════════════════
# Docker Configuration
# ═══════════════════════════════════════════════════════════════

# Host port mappings (host:container)
# HOST_GUARD_PORT=3000
# HOST_ATTACKER_PORT=8888

# Container resource limits
# DOCKER_MEMORY_LIMIT=512m
# DOCKER_CPU_LIMIT=1.0

# ═══════════════════════════════════════════════════════════════
# Security Best Practices
# ═══════════════════════════════════════════════════════════════
#
# 1. NEVER commit .env files to version control
#    Add .env to .gitignore (already done in this project)
#
# 2. Use strong, unique secrets for production
#    Generate with: openssl rand -base64 32
#
# 3. Rotate secrets regularly
#    Change API keys and secrets every 90 days minimum
#
# 4. Use different secrets for dev/staging/production
#    Never reuse production secrets in development
#
# 5. Consider using Secret Gate for production
#    Keeps secrets in memory instead of plaintext files
#    Start with: airlock secret-gate start --env .env
#
# 6. Use environment-specific files
#    .env.development, .env.production, .env.test
#    Load the right one based on NODE_ENV
#
# 7. Limit access to .env files
#    chmod 600 .env (read/write for owner only)
#
# 8. Use secret management systems in production
#    AWS Secrets Manager, HashiCorp Vault, Azure Key Vault, etc.
#
# ═══════════════════════════════════════════════════════════════

# Example: Generate a secure random secret
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
